__pycache__/
*.pyc

# Transient — created only when running scripts/smoke_test.mjs locally
# (`npm install playwright`). This project has no build step; none of these
# are committed.
node_modules/
package.json
package-lock.json

# Transient — Leaflet fetched by scripts/vendor_leaflet.sh so the smoke test can
# serve it same-origin where the browser can't reach the CDN (Claude Code web).
# Third-party asset, never committed; production and CI load Leaflet from the CDN.
#
# UNANCHORED (`**/`), because the script vendors ONE COPY PER INSTANCE and a
# pattern containing a slash is anchored to the repo root — `scripts/vendor/`
# matched the root copy and never il/'s, ca/'s or ny/'s. That went unnoticed only
# because each imported instance still carried its own .gitignore from its fork
# days; the R5 rename moved sf/.gitignore to ca/ and left sf/scripts/vendor/
# behind unignored, where the next `git add -A` staged 160 KB of third-party
# Leaflet. Ignoring the directory NAME covers every instance, including the next
# one, and needs nothing from a per-instance file that may not exist.
**/scripts/vendor/

# Transient — outputs of scripts/perf_profile.mjs (the performance harness behind
# docs/PERFORMANCE_ANALYSIS_2026-07.md). Regenerated on demand; never committed.
perf-results.json
docs/perf-app-screenshot.png

# Generic build-output guard. Nothing in the tree writes here today — this
# project has no build step. The reason recorded for it was
# `build_engine_artifact.py --out dist/`, and it sat beside
# /engine.bundle.js and /engine.manifest.json, the pinned release artifact
# `apply_engine.py` downloaded. Those three scripts and both files left at
# R2.1 with the engine release channel (docs/ENGINE_SYNC.md), so the two
# ignores went with them on 2026-09-12; dist/ is kept as a plain guard.
dist/

# Claude Code agent worktrees — transient, harness-managed
.claude/worktrees/

# Ad-hoc browser harnesses. Verifying something in real Chromium means writing a
# throwaway .mjs INSIDE the repo (node resolves playwright from ./node_modules,
# so /tmp will not do), and five of them once rode a `git add -A` into main —
# where the deploy's rsync would have published them, since -a copies dotfiles
# and no exclude names them. Name a scratch harness like this and it cannot.
/.scratch-*.mjs
/.*-test.mjs

# A --force-blocked build of a LICENSED source writes here, never into
# il/data/app/. The licence forbids redistributing a derived product, and a
# forgotten file in the tree is exactly how one would ship
# (scripts/build_parcel_fabric_districts.py).
/scratch/
