{
  "id": "/",
  "name": "districtry",
  "short_name": "districtry",
  "description": "Enter an address or ZIP — districtry shows every civic district that covers that point on the map, and the people who hold those seats. Free, no login.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F4F7F9",
  "theme_color": "#6d3fd1",
  "icons": [
    {
      "src": "/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "https://districtry.com/app/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Use my location",
      "short_name": "My location",
      "description": "Show the districts where you are now",
      "url": "https://districtry.com/app/#locate",
      "icons": [
        {
          "src": "/shortcut-locate-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Report a problem",
      "short_name": "Report",
      "description": "Tell districtry about a wrong answer or a bug",
      "url": "https://districtry.com/app/#feedback",
      "icons": [
        {
          "src": "/shortcut-report-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}
